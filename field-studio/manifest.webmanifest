{
  "name": "잉크원_st_AI",
  "short_name": "잉크원_st_AI",
  "description": "잉크원_st_AI — 현장 사진과 한 줄 메모로 블로그·쇼츠·스레드·인스타 원고를 만들고 네이버·구글 블로그·니케·로컬 PC로 내보내는 앱",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "/mars-secretary/field-studio/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef3f0",
  "theme_color": "#08251c",
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/heic",
            "image/heif",
            "image/*"
          ]
        }
      ]
    }
  },
  "categories": [
    "productivity",
    "business"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
